<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:alignmentMode="alignMargins"
    android:columnCount="3"
    android:rowCount="7"
    android:useDefaultMargins="true">

    <!-- Display de la calculadora -->
    <TextView
        android:id="@+id/display"
        android:layout_width="320dp"
        android:layout_height="80dp"
        android:layout_columnSpan="3"
        android:background="#CFC6B8"
        android:textColor="#000000"
        android:gravity="end|center_vertical"
        android:padding="12dp"
        android:text="0"
        android:textSize="25sp" />

    <!-- Primera fila -->
    <Button
        android:id="@+id/b1"
        android:text="1"
        android:backgroundTint="#D4AF37" />

    <Button
        android:id="@+id/b2"
        android:text="2"
        android:backgroundTint="#7E57C2" />

    <Button
        android:id="@+id/b3"
        android:text="3"
        android:backgroundTint="#D4AF37" />

    <!-- Segunda fila -->
    <Button
        android:id="@+id/b4"
        android:text="4"
        android:backgroundTint="#7E57C2" />

    <Button
        android:id="@+id/b5"
        android:text="5"
        android:backgroundTint="#D4AF37" />

    <Button
        android:id="@+id/b6"
        android:text="6"
        android:backgroundTint="#7E57C2" />

    <!-- Tercera fila -->
    <Button
        android:id="@+id/b7"
        android:text="7"
        android:backgroundTint="#D4AF37" />

    <Button
        android:id="@+id/b8"
        android:text="8"
        android:backgroundTint="#7E57C2" />

    <Button
        android:id="@+id/b9"
        android:text="9"
        android:backgroundTint="#D4AF37" />

    <!-- Cuarta fila -->
    <Button
        android:id="@+id/bmas"
        android:text="+"
        android:backgroundTint="#7E57C2" />

    <Button
        android:id="@+id/b0"
        android:text="0"
        android:backgroundTint="#D4AF37" />

    <Button
        android:id="@+id/bmenos"
        android:text="-"
        android:backgroundTint="#7E57C2" />

    <!-- Quinta fila -->
    <Button
        android:id="@+id/bmultiplicar"
        android:text="*"
        android:backgroundTint="#D4AF37" />

    <Button
        android:id="@+id/bcoma"
        android:text=","
        android:backgroundTint="#7E57C2" />

    <Button
        android:id="@+id/bdividir"
        android:text="/"
        android:backgroundTint="#D4AF37" />

    <!-- Sexta fila -->
    <Button
        android:id="@+id/bigual"
        android:text="="
        android:backgroundTint="#7E57C2" />

    <Button
        android:id="@+id/bc"
        android:text="C"
        android:backgroundTint="#D4AF37" />

    <Button
        android:id="@+id/bac"
        android:text="AC"
        android:backgroundTint="#7E57C2" />

</GridLayout>
